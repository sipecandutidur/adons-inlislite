# ==========================================
# Docker Compose Environment Variables
# ==========================================
# Copy this file to .env and fill in the values
# File ini dibaca oleh docker-compose.yml
# ==========================================

# ========================================
# MySQL Security
# ========================================
# Password root MySQL — HANYA untuk administrasi darurat
# Backend TIDAK menggunakan root, tapi user 'adons_app'
MYSQL_ROOT_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_ROOT

# ========================================
# App Database (MySQL in Docker)
# ========================================
# User khusus untuk aplikasi (bukan root!)
DB_APP_USER=adons_app
DB_APP_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_APP
DB_APP_NAME=alternative_inlislite

# Path penyimpanan data MySQL di HOST
# Data TIDAK disimpan di dalam Docker container
MYSQL_DATA_PATH=/var/lib/adons-inlislite/mysql

# ========================================
# Inlislite Database (jaringan lokal)
# ========================================
DB_INLISLITE_HOST=192.168.35.8
DB_INLISLITE_PORT=3309
DB_INLISLITE_USER=rfid2
DB_INLISLITE_PASSWORD=GANTI_DENGAN_PASSWORD_INLISLITE
DB_INLISLITE_NAME=inlislite_v31_depok

# ========================================
# CORS (opsional, comma-separated)
# ========================================
# ALLOWED_ORIGINS=https://perpustakaan.example.com
